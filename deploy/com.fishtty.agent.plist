<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fishtty-agent launchd 服务 — macOS 开机自启

  安装步骤：
    1. sudo cp fishtty-agent /usr/local/bin/
    2. mkdir -p ~/.config/fishtty
    3. cp configs/fishtty-agent.yaml ~/.config/fishtty/
    4. 编辑 ~/.config/fishtty/fishtty-agent.yaml，填入 server 和 token
    5. cp deploy/com.fishtty.agent.plist ~/Library/LaunchAgents/
    6. launchctl load ~/Library/LaunchAgents/com.fishtty.agent.plist

  管理：
    launchctl list | grep fishtty              # 查看状态
    tail -f /usr/local/var/log/fishtty-agent.log  # 查看日志
    launchctl unload ~/Library/LaunchAgents/com.fishtty.agent.plist  # 卸载
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fishtty.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fishtty-agent</string>
        <string>--config</string>
        <string>/Users/REPLACE_USERNAME/.config/fishtty/fishtty-agent.yaml</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/fishtty-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/fishtty-agent.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>/Users/REPLACE_USERNAME</string>
    </dict>
</dict>
</plist>
